# Vendored reference repo: 53 MB of someone else's project, kept locally only.
# The engine-audio technique is reimplemented in src/audio.js and the five
# samples we actually use live in assets/audio/.
engine-audio-master/

node_modules/
.DS_Store
*.log

# Local machine settings, not shared
.claude/settings.local.json

# Unoptimised car source models. The -optimized.glb files beside them are what
# the game loads: 43 MB of raw exports became 4.5 MB through mesh optimisation
# and Draco, which for a game whose whole pitch is "open it and drive" is the
# difference between a playable download and a broken promise. Keep the
# originals locally to re-export from; they have no business in the repo.
assets/cars/*[!d].glb
!assets/cars/*-optimized.glb
